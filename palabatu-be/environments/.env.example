PORT=3001

# Path to the built frontend (palabatu-fe/dist), served for non-API routes.
# Defaults to ../palabatu-fe/dist (relative to `go run ./cmd/api`'s cwd) if unset.
STATIC_DIR=../palabatu-fe/dist

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/palabatu

# Secret used to sign/verify JWTs
JWT_SECRET=your_jwt_secret

# Nodemailer (using Resend's SMTP)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Base URL used to build verification/reset links in emails
CLIENT_URL=http://localhost:3001

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
