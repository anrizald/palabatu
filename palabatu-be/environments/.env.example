PORT=3001

# Path to the built frontend (palabatu-fe/dist), served for non-API routes.
# Defaults to ../palabatu-fe/dist (relative to `go run ./cmd/api`'s cwd) if unset.
STATIC_DIR=../palabatu-fe/dist

# Comma-separated CIDRs/IPs of reverse proxies allowed to set the client IP
# via X-Forwarded-For. Leave unset locally (no proxy). In production this is
# the Docker network Caddy talks to the app over - see deploy/compose.yml.
# Not optional there: gin trusts every proxy by default, which would let a
# client forge X-Forwarded-For and bypass middleware.RateLimit's per-IP
# buckets entirely.
# TRUSTED_PROXIES=172.28.0.0/16

# PostgreSQL connection string. This default matches the credentials in the
# root docker-compose.yml (`docker compose up -d`), which also runs
# migrations/ automatically - no separate migrate step needed for local dev.
DATABASE_URL=postgresql://user:password@localhost:5432/palabatu?sslmode=disable

# Secret used to sign/verify JWTs
JWT_SECRET=your_jwt_secret

# users.id of the single account allowed to use the owner-only Developer
# page (GET/POST /api/dev/*, middleware.RequireOwner). Not a role/title --
# Council/Associate/Warden are community tiers meant to be held by more
# than one person, this is for one account.
OWNER_USER_ID=your_user_id

# Transactional email, sent via Resend's SMTP endpoint (smtp.resend.com).
# Get RESEND_API_KEY from resend.com (free tier). On the free tier you can only
# send from the shared onboarding@resend.dev sandbox address, and only to the
# email address of the Resend account owner (unless you verify a custom domain) -
# so test signup/reset flows using the same email you signed up to Resend with.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Base URL used to build verification/reset links in emails
CLIENT_URL=http://localhost:3001

# Cloudinary (image uploads). Sign up at cloudinary.com (free tier). Cloud
# Name is on the Console dashboard; API Key/API Secret are under
# Settings > API Keys (that page also has a copyable "API Environment
# variable" combining all three, if that's easier).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
